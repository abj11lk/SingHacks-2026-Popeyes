# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Groq (LLM inference for the agent layer)
GROQ_API_KEY=

# Supabase (app state: recommendation queue, RM accept/edit/reject decisions,
# agent-run audit log -- NOT the reference dataset, which stays in local
# SQLite, see backend/db.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LangSmith (tracing for the LangGraph agent layer)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=wealth-intelligence
