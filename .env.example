# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Groq (LLM inference for the agent layer)
GROQ_API_KEY=

# Supabase (app state: recommendation queue, RM accept/edit/reject decisions,
# agent-run audit log -- NOT the reference dataset, which stays in local
# SQLite, see backend/db.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection (Supabase session pooler -- use the pooler host, not
# db.<ref>.supabase.co directly, which is IPv6-only and unreachable from a
# default Docker network). Optional: backend/db.py falls back to local
# SQLite if this is unset or unreachable.
DATABASE_URL=

# LangSmith (tracing for the LangGraph agent layer). Current (2026) env var
# names -- create the key from *inside* a specific workspace, not the
# organization-level settings page, or trace ingestion 403s with
# org_scoped_key_requires_workspace. Only set LANGSMITH_WORKSPACE_ID if
# you end up using an org-scoped key instead.
#
# LANGSMITH_ENDPOINT matters more than it looks: LangSmith has separate
# regional deployments (US default, EU, APAC). A key from a non-US workspace
# 403s against the default host with a bare {"detail":"Forbidden"} and no
# indication region is the problem -- check Settings in the LangSmith
# dashboard for your account's actual endpoint (e.g.
# https://apac.api.smith.langchain.com) rather than assuming the default.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wealth-intelligence
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=
